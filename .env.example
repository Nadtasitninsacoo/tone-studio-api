# Copy to .env and adjust. Every value below is optional — the defaults shown
# are what the server uses when the variable is absent.

# Port to listen on. Default 3100, deliberately NOT 3000: `next dev` claims
# 3000/3001, and a backend that silently loses the port race is a confusing
# first-run failure.
PORT=3100

# Comma-separated list of browser origins allowed to call this API.
# Defaults to localhost/127.0.0.1 on ports 3000 and 3001.
# Any new client (a second web app, a staging domain) must be added here or the
# browser will block its fetches — the server itself never blocks them.
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Where takes are written. Defaults to ./storage relative to the working
# directory. Point this at a mounted volume in production — the audio files are
# the only unrecoverable data this service holds.
# STORAGE_DIR=/var/lib/guitar-recorder
